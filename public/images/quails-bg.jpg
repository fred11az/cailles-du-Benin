<svg xmlns="http://www.w3.org/2000/svg" width="800" height="800" viewBox="0 0 800 800">
  <defs>
    <linearGradient id="bgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ECFDF5;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#D1FAE5;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect fill="url(#bgGrad)" width="800" height="800"/>

  <!-- Nest -->
  <ellipse cx="400" cy="550" rx="280" ry="100" fill="#D4A574"/>
  <ellipse cx="400" cy="530" rx="250" ry="80" fill="#E5C9A8"/>

  <!-- Eggs in nest -->
  <ellipse cx="300" cy="480" rx="50" ry="65" fill="#F5E6D3" stroke="#D4A574" stroke-width="2"/>
  <ellipse cx="400" cy="460" rx="55" ry="70" fill="#F5E6D3" stroke="#D4A574" stroke-width="2"/>
  <ellipse cx="500" cy="480" rx="50" ry="65" fill="#F5E6D3" stroke="#D4A574" stroke-width="2"/>

  <!-- Spots on eggs -->
  <circle cx="280" cy="460" r="6" fill="#A3724D" opacity="0.5"/>
  <circle cx="310" cy="490" r="5" fill="#A3724D" opacity="0.4"/>
  <circle cx="380" cy="440" r="7" fill="#A3724D" opacity="0.5"/>
  <circle cx="420" cy="475" r="5" fill="#A3724D" opacity="0.4"/>
  <circle cx="480" cy="460" r="6" fill="#A3724D" opacity="0.5"/>
  <circle cx="510" cy="495" r="5" fill="#A3724D" opacity="0.4"/>

  <!-- Decorative leaves -->
  <path d="M150 600 Q200 500 180 400" fill="none" stroke="#22C55E" stroke-width="4"/>
  <ellipse cx="170" cy="450" rx="30" ry="15" fill="#22C55E" transform="rotate(-30 170 450)"/>
  <ellipse cx="160" cy="500" rx="25" ry="12" fill="#22C55E" transform="rotate(-45 160 500)"/>

  <path d="M650 600 Q600 500 620 400" fill="none" stroke="#22C55E" stroke-width="4"/>
  <ellipse cx="630" cy="450" rx="30" ry="15" fill="#22C55E" transform="rotate(30 630 450)"/>
  <ellipse cx="640" cy="500" rx="25" ry="12" fill="#22C55E" transform="rotate(45 640 500)"/>

  <!-- Text -->
  <text x="400" y="250" text-anchor="middle" font-family="Arial, sans-serif" font-size="48" font-weight="bold" fill="#16A34A">Mahutin Ferme</text>
  <text x="400" y="310" text-anchor="middle" font-family="Arial, sans-serif" font-size="24" fill="#22C55E">Cailles du Bénin</text>
</svg>