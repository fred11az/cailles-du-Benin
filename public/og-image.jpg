<svg xmlns="http://www.w3.org/2000/svg" width="1200" height="630" viewBox="0 0 1200 630">
  <defs>
    <linearGradient id="ogBgGrad" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#ECFDF5;stop-opacity:1" />
      <stop offset="100%" style="stop-color:#D1FAE5;stop-opacity:1" />
    </linearGradient>
  </defs>
  <rect fill="url(#ogBgGrad)" width="1200" height="630"/>

  <!-- Logo circle -->
  <circle cx="200" cy="315" r="80" fill="#22C55E"/>
  <text x="200" y="335" text-anchor="middle" font-family="Arial, sans-serif" font-size="48" font-weight="bold" fill="white">MF</text>

  <!-- Main text -->
  <text x="350" y="280" font-family="Arial, sans-serif" font-size="64" font-weight="bold" fill="#111827">Mahutin Ferme</text>
  <text x="350" y="350" font-family="Arial, sans-serif" font-size="36" fill="#22C55E">Cailles du Bénin</text>
  <text x="350" y="420" font-family="Arial, sans-serif" font-size="24" fill="#6B7280">Oeufs et viande de caille frais</text>
  <text x="350" y="460" font-family="Arial, sans-serif" font-size="24" fill="#6B7280">Livraison dans tout le Bénin</text>

  <!-- Decorative eggs -->
  <ellipse cx="1000" cy="200" rx="60" ry="80" fill="#F5E6D3" stroke="#D4A574" stroke-width="2"/>
  <ellipse cx="1080" cy="280" rx="50" ry="65" fill="#F5E6D3" stroke="#D4A574" stroke-width="2"/>
  <ellipse cx="1040" cy="380" rx="55" ry="70" fill="#F5E6D3" stroke="#D4A574" stroke-width="2"/>

  <!-- Spots -->
  <circle cx="980" cy="180" r="6" fill="#A3724D" opacity="0.5"/>
  <circle cx="1020" cy="220" r="5" fill="#A3724D" opacity="0.4"/>
  <circle cx="1060" cy="260" r="6" fill="#A3724D" opacity="0.5"/>
  <circle cx="1100" cy="300" r="5" fill="#A3724D" opacity="0.4"/>
  <circle cx="1020" cy="360" r="7" fill="#A3724D" opacity="0.5"/>
  <circle cx="1060" cy="400" r="5" fill="#A3724D" opacity="0.4"/>

  <!-- Bottom bar -->
  <rect x="0" y="580" width="1200" height="50" fill="#22C55E"/>
  <text x="600" y="612" text-anchor="middle" font-family="Arial, sans-serif" font-size="20" fill="white">cailledubenin.com | +229 00 00 00 00</text>
</svg>